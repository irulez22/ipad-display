<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ipaddisplay.updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/paddisplay-update</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>WatchPaths</key>
    <array>
        <string>/var/mobile/Library/PadDisplayUpdater/check-now</string>
    </array>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
