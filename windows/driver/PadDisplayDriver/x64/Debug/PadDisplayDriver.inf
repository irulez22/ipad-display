;
; IddSampleDriver.inf
;

[Version]
PnpLockDown=1
Signature="$Windows NT$"
ClassGUID = {4D36E968-E325-11CE-BFC1-08002BE10318}
Class = Display
ClassVer = 2.0
Provider=%ManufacturerName%
CatalogFile=PadDisplayDriver.cat
DriverVer = 10/05/2026,22.55.52.861

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...22000

[Standard.NTamd64.10.0...22000]
%DeviceName%=MyDevice_Install, Root\PadDisplay ; TODO: edit hw-id, this hardware id is used by Visual Studio remote debugging
%DeviceName%=MyDevice_Install, PadDisplay           ; TODO: edit hw-id, this hardware if is used by the IddSampleApp.exe

[SourceDisksFiles]
PadDisplayDriver.dll=1

[SourceDisksNames]
1 = %DiskName%

; =================== UMDF Device ==================================

[MyDevice_Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=UMDriverCopy

[MyDevice_Install.NT.hw]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg = MyDevice_HardwareDeviceSettings

[MyDevice_HardwareDeviceSettings]
HKR,, "UpperFilters",  %REG_MULTI_SZ%, "IndirectKmd"
HKR, "WUDF", "DeviceGroupId", %REG_SZ%, "PadDisplayDriverGroup" ; TODO: edit driver group name, see README.md for more info

[MyDevice_Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[MyDevice_Install.NT.Wdf]
UmdfService=PadDisplayDriver,PadDisplayDriver_Install
UmdfServiceOrder=PadDisplayDriver
UmdfKernelModeClientPolicy = AllowKernelModeClients

[PadDisplayDriver_Install]
UmdfLibraryVersion=2.25.0
ServiceBinary=%12%\UMDF\PadDisplayDriver.dll
UmdfExtensions = IddCx0102

[DestinationDirs]
UMDriverCopy=12,UMDF ; copy to drivers\umdf

[UMDriverCopy]
PadDisplayDriver.dll

; =================== Generic ==================================

[Strings]
ManufacturerName="PadDisplay" ; TODO: Replace with your manufacturer name
DiskName = "PadDisplay Driver Installation Disk" ; TODO: Replace with driver disk name
DeviceName="PadDisplay Virtual Display" ; TODO: Replace with correct device name

REG_MULTI_SZ  = 0x00010000
REG_SZ        = 0x00000000

